# ============================================
# ZWToken Deployment Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# Required: Deployer Account
# ============================================
# Private key of the deployer account (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# ============================================
# Required: Network RPC URLs
# ============================================
# At least one network RPC URL is required based on your deployment target
# Format: <NETWORK>_RPC_URL

# Ethereum Mainnet
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Ethereum Sepolia Testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Ethereum Goerli Testnet (deprecated)
GOERLI_RPC_URL=https://eth-goerli.g.alchemy.com/v2/YOUR_API_KEY

# Arbitrum Mainnet
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Arbitrum Sepolia Testnet
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Optimism Mainnet
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Optimism Sepolia Testnet
OPTIMISM_SEPOLIA_RPC_URL=https://opt-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Polygon Mainnet
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Polygon Mumbai Testnet
POLYGON_MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_API_KEY

# BSC Mainnet
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# BSC Testnet
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# ============================================
# Optional: Contract Verification
# ============================================
# Etherscan API key for contract verification
# Get your API key from: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================
# Optional: Deployment Configuration
# ============================================
# Path to deployment configuration file (default: deploy.config.json)
# DEPLOY_CONFIG=./deploy.config.json
